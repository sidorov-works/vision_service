# dockerfile.base

# Базовый образ с PyTorch + CUDA 12.4
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /app

# Системные зависимости для обработки изображений и работы моделей
# libgl1-mesa-glx и libglib2.0-0 нужны для Pillow и OpenCV (если понадобится)
# libsm6, libxext6, libxrender-dev - для X11 (нужны некоторым моделям)
# libgomp1 - для параллельных вычислений
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Копируем общие зависимости (не зависящие от конкретной модели)
COPY requirements.base.txt .
RUN pip install --no-cache-dir -r requirements.base.txt

# Копируем общий код, который не меняется между моделями
COPY main.py .
COPY shared/ ./shared/
COPY workers/ ./workers/

# Создаём директории для кэша моделей и логов
RUN mkdir -p /app/models /app/logs

# Переменные окружения по умолчанию
ENV PYTHONPATH=/app
ENV DOCKER_ENV=true

# Порт сервера
EXPOSE 8080