# dockerfile.lfm25

# LFM2.5-VL (450M параметров) - лёгкая VLM модель от Liquid AI
FROM vision-base:latest

# Устанавливаем специфичные зависимости для LFM2.5-VL
# ВНИМАНИЕ: LFM2.5-VL работает с transformers версии 4.57.0
COPY requirements.lfm25.txt .
RUN pip install --no-cache-dir -r requirements.lfm25.txt

# Переменные окружения для этой модели
ENV BACKEND=transformers 
ENV MODEL=lfm25-vl 
ENV DEVICE=cuda         

# Запускаем Uvicorn с 1 воркером (модель занимает много памяти)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]